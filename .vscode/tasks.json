{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build Cpp integration",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "src/CommunityToolkit.Aspire.Hosting.Cpp/CommunityToolkit.Aspire.Hosting.Cpp.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build Cpp example",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "examples/cpp/CommunityToolkit.Aspire.Hosting.Cpp.AppHost/CommunityToolkit.Aspire.Hosting.Cpp.AppHost.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test Cpp unit tests",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "tests/CommunityToolkit.Aspire.Hosting.Cpp.Tests/CommunityToolkit.Aspire.Hosting.Cpp.Tests.csproj",
        "--filter-not-trait",
        "Category=Integration"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test Cpp integration test",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "tests/CommunityToolkit.Aspire.Hosting.Cpp.Tests/CommunityToolkit.Aspire.Hosting.Cpp.Tests.csproj",
        "--filter-trait",
        "Category=Integration"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "cleanup",
      "type": "shell",
      "command": "./eng/clean-bin-obj.sh",
      "problemMatcher": [],
      "linux": {
        "options": {
          "shell": {
            "executable": "bash"
          }
        }
      }
    }
  ],
  "inputs": [
    {
      "type": "promptString",
      "id": "projectName",
      "description": "Enter the name of the project",
      "default": "CommunityToolkit.Aspire.MyIntegration"
    }
  ]
}